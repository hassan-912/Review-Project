# .env.example — copy this file to .env and fill in your real values.
# Never commit .env to version control.

# Gemini API key — obtain from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Supabase project URL — found in Supabase dashboard → Project Settings → API
SUPABASE_URL=

# Supabase anon (public) key — used for isolated server-side user authentication
SUPABASE_ANON_KEY=

# Supabase service-role key — used server-side to bypass RLS; keep this secret
SUPABASE_SERVICE_ROLE_KEY=

# Preferred model first, followed by fallbacks
GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite

# Production URL; also allowlist it in Supabase Auth URL settings
APP_URL=

# Fresh AI analyses per approved user in rolling windows
REVIEWS_PER_HOUR=5
REVIEWS_PER_DAY=20
