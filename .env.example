# .env.example — copy this file to .env and fill in your real values.
# Never commit .env to version control.


# Supabase project URL — found in Supabase dashboard → Project Settings → API
SUPABASE_URL=

# Supabase anon (public) key — used for isolated server-side user authentication
SUPABASE_ANON_KEY=

# Supabase service-role key — used server-side to bypass RLS; keep this secret
SUPABASE_SERVICE_ROLE_KEY=


# Production URL; also allowlist it in Supabase Auth URL settings
APP_URL=

# Per-user review limits are stored in profiles; maximum is five reviews per Cairo calendar day (midnight reset).

# Sentry project Settings > Client Keys (DSN). Leave empty to disable reporting.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=

# Paid Gemini Developer API. Server-side only; never paste a key into chat or client code.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
# Optional positive USD/EGP override. Blank uses the dated public cross-rate feed.
USD_EGP_RATE=
