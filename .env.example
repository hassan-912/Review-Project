# .env.example — copy this file to .env and fill in your real values.
# Never commit .env to version control.

# Gemini API key — obtain from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Supabase project URL — found in Supabase dashboard → Project Settings → API
SUPABASE_URL=

# Supabase anon (public) key — used for isolated server-side user authentication
SUPABASE_ANON_KEY=

# Supabase service-role key — used server-side to bypass RLS; keep this secret
SUPABASE_SERVICE_ROLE_KEY=

# Four free models route automatically; manage order/caps in the super-admin dashboard.
# Personal Google Pro / ChatGPT Plus subscriptions do not select this app's API billing tier.

# Production URL; also allowlist it in Supabase Auth URL settings
APP_URL=

# Per-user review limits are stored in profiles; initial defaults are 5/hour and 20/24 hours.
